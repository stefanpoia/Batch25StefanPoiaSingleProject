
pipeline {
    agent any

environment {
    NEWMAN_DIR = 'C:\\Users\\User\\AppData\\Roaming\\npm'
}

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        
stage('Check Newman') {
    steps {
        bat 'node --version'
        bat 'npm --version'
        bat '"%NEWMAN_DIR%\\newman.cmd" --version'
    }
}


       
stage('Run Postman API Tests') {
    steps {
        withCredentials([usernamePassword(
            credentialsId: 'hrms-login',
            usernameVariable: 'HRMS_USER',
            passwordVariable: 'HRMS_PASSWORD'
        )]) {
            bat '''
                "%NEWMAN_DIR%\\newman.cmd" run "Syntax HRMS API Testing - SCRUM-6.postman_collection.json" --env-var "baseUrl=https://syntaxhrm.com" --env-var "username=%HRMS_USER%" --env-var "password=%HRMS_PASSWORD%"
            '''
        }
    }
}

}


    post {
        always {
            echo 'SCRUM-6 Jenkins Pipeline finished.'
        }
    }
}
