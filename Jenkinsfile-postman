
pipeline {
    agent any

environment {
    NEWMAN_DIR = 'C:\\Users\\User\\AppData\\Roaming\\npm'
}

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        
stage('Check Newman') {
    steps {
        bat 'node --version'
        bat 'npm --version'
        bat '"%NEWMAN_DIR%\\newman.cmd" --version'
    }
}


        stage('Run Postman API Tests') {
            steps {
                echo 'SCRUM-6: API tests will be configured after environment and credentials verification.'
            }
        }
    }

    post {
        always {
            echo 'SCRUM-6 Jenkins Pipeline finished.'
        }
    }
}
